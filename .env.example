# 智能舆情分析平台 · 环境配置模板
#
# 使用方式：复制为 .env 后按实际环境填写
#     cp .env.example .env
#
# 安全约定：
#   1. .env 已在 .gitignore 中排除，禁止提交到版本库；
#   2. 密钥不得出现在代码、文档、日志中（日志层已做脱敏，见 engines/common/logging.py）；
#   3. 未填写的密钥不会导致服务启动失败——相关能力在调用时降级并给出明确提示。

# ---------------- 服务 ----------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# 前端开发服务器地址，用于 CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- 数据库 ----------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sentiment_monitor
DB_CHARSET=utf8mb4

# ---------------- 认知分析模型（打标，调用量最大，建议选性价比高的模型）----------------
ANALYTICS_API_KEY=
ANALYTICS_BASE_URL=
ANALYTICS_MODEL_NAME=

# ---------------- 私域研究员（InsightAgent）----------------
INSIGHT_ENGINE_API_KEY=
INSIGHT_ENGINE_BASE_URL=
INSIGHT_ENGINE_MODEL_NAME=

# ---------------- 公域研究员（MediaAgent）----------------
MEDIA_ENGINE_API_KEY=
MEDIA_ENGINE_BASE_URL=
MEDIA_ENGINE_MODEL_NAME=

# ---------------- 主持人研判（HostAgent）----------------
# 注意：环境变量前缀为 HOST_AGENT，避免与服务监听地址 HOST 冲突
HOST_AGENT_API_KEY=
HOST_AGENT_BASE_URL=
HOST_AGENT_MODEL_NAME=

# ---------------- 报告引擎（ReportEngine）----------------
REPORT_ENGINE_API_KEY=
REPORT_ENGINE_BASE_URL=
REPORT_ENGINE_MODEL_NAME=

# ---------------- 公域搜索（MediaAgent 使用）----------------
SEARCH_TOOL_TYPE=bocha
TAVILY_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn/v1/ai-search
BOCHA_API_KEY=
ANSPIRE_BASE_URL=https://plugin.anspire.cn/api/ntsearch/search
ANSPIRE_API_KEY=

# ---------------- 向量召回（首版必需，见设计规格 D-04）----------------
INSIGHT_VECTOR_ENABLED=true
MILVUS_URI=http://localhost:19530
MILVUS_DB_NAME=default
MILVUS_INSIGHT_COLLECTION=insight_evidence
# 中文 Embedding 模型（本地路径或模型名），选型见设计规格 Q4
EMBEDDING_MODEL=
INSIGHT_VECTOR_TOP_K=80

# ---------------- OCR 云服务（MCP / SSE transport）----------------
OCR_MCP_URL=https://dashscope.aliyuncs.com/api/v1/mcps/ai-ocr/sse
DASHSCOPE_API_KEY=
OCR_TIMEOUT_SECONDS=20

# ---------------- 邮件告警通知 ----------------
# QQ 邮箱使用 SSL 465 端口；SMTP_PASSWORD 填「授权码」而非登录密码
# 授权码获取：QQ 邮箱 → 设置 → 账户 → 开启 SMTP 服务
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_MAIL_TO=

# ---------------- 舆情烈度指数权重（决定风险分级）----------------
INTENSITY_W_NEGATIVE=0.50
INTENSITY_W_VOLUME=0.30
INTENSITY_W_KOL=0.12
INTENSITY_W_SENSITIVE=0.15

# ---------------- 报告产物目录（留空则使用项目内默认路径）----------------
OUTPUT_DIR=
HOST_REPORT_DIR=
INSIGHT_REPORT_DIR=
MEDIA_REPORT_DIR=

# ---------------- 会话 ----------------
# 留空时服务会在启动时生成临时密钥（仅适用于开发环境，重启后会话失效）
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=28800
